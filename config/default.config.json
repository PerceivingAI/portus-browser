{
  "broker": {
    "transport": "local",
    "pipeName": "portus-browser-broker",
    "heartbeatIntervalMs": 5000,
    "sessionTimeoutMs": 20000
  },
  "nativeHost": {
    "name": "com.portus.browser",
    "brokerPipeName": "portus-browser-broker",
    "startBrokerIfMissing": true,
    "connectTimeoutMs": 5000
  },
  "cli": {
    "output": "table"
  },
  "sessions": {
    "defaultTargetStrategy": "oldest"
  },
  "commands": {
    "timeoutMs": 15000,
    "normalizeUrls": true
  },
  "security": {
    "allowedUploadRoots": [],
    "requireBrokerToken": true
  },
  "policy": {
    "defaultPolicyMode": "blocklist",
    "defaultAllowedNavigationRules": [],
    "defaultBlockedNavigationRules": [],
    "sessionStepRetentionLimit": 10
  },
  "events": {
    "retentionLimit": 1000
  },
  "logging": {
    "redactUrls": false,
    "redactTitles": false
  },
  "terminal": {
    "enabled": true,
    "defaultProfileId": "auto",
    "manualTerminalPath": null,
    "startupCommand": null,
    "defaultWorkingDirectory": "Downloads/portus-session",
    "fontSize": 16,
    "maxSessions": 5,
    "idleTimeoutMs": 1800000
  }
}
